# Copy this file to .env and fill in local values. Never commit .env.
PORT=3001
NODE_ENV=development
DEMO_MODE=true

# Replace with a long random secret outside local demo use.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Real OTP email via Resend SMTP (domain studeal.namprojects.site verified in Resend).
# EMAIL_USER is literally "resend"; EMAIL_APP_PASSWORD is the Resend API key (re_...).
# Leave EMAIL_APP_PASSWORD empty for debug OTP in demo mode.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=resend
EMAIL_APP_PASSWORD=
EMAIL_FROM=Studeal <no-reply@studeal.namprojects.site>

OTP_EXPIRES_MINUTES=5
PLATFORM_FEE_PERCENT=2
VIP_FEE=15000

DB_FILE=./data/studeal.sqlite
UPLOAD_DIR=./uploads
FRONTEND_DIR=../frontend/public
PUBLIC_BASE_URL=http://localhost:3001
