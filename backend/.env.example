# Copy this file to .env and fill in local values. Never commit .env.
PORT=3001
NODE_ENV=development
DEMO_MODE=true

# Replace with a long random secret outside local demo use.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional Gmail SMTP for real OTP email. Leave empty for debug OTP in demo mode.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=Studeal <no-reply@studeal.vn>

OTP_EXPIRES_MINUTES=5
PLATFORM_FEE_PERCENT=2
VIP_FEE=15000

DB_FILE=./data/studeal.sqlite
UPLOAD_DIR=./uploads
FRONTEND_DIR=../frontend/public
PUBLIC_BASE_URL=http://localhost:3001
